        "n": 42,
        "payload": {
          "_bytes": "aGk"
        }
      },
      "tags": [
        "nominal",
        "record"
      ],
      "why": "a record reaches the Rust author as a real struct; the round trip goes through the generated to_json/from_json, so this passing means BOTH directions encode the fields"
    },
